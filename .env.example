# QFabric root environment (used by docker-compose.yml and scripts/).
# Copy to .env (git-ignored). Module-specific examples:
#   quantum-pqc/.env.example, blockchain/.env.example

# Crypto service
QFABRIC_API_PORT=8000
QFABRIC_QBER_THRESHOLD=0.11
QFABRIC_MAX_DOCUMENT_BYTES=10485760
QFABRIC_LOG_LEVEL=INFO

# Blockchain client
QFABRIC_CRYPTO_API_URL=http://localhost:8000/api/v1
QFABRIC_ORG=OrgA
QFABRIC_CHANNEL=mychannel
QFABRIC_CHAINCODE=qfabric-audit

# Fabric versions
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
