# Quantum/PQC service settings. Copy to quantum-pqc/.env (git-ignored).
QFABRIC_API_HOST=0.0.0.0
QFABRIC_API_PORT=8000
# Directory holding ML-DSA secret keys (mode 0600). Never commit it.
QFABRIC_KEYSTORE_DIR=.keystore
# Upper bound for documents (bytes), also the decompression-bomb limit.
QFABRIC_MAX_DOCUMENT_BYTES=10485760
# BB84 abort threshold. Must not exceed 0.11 (ledger policy rejects looser values).
QFABRIC_QBER_THRESHOLD=0.11
QFABRIC_LOG_LEVEL=INFO
