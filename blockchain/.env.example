# Blockchain module settings. Copy to blockchain/.env (git-ignored).
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.22
FABRIC_STATE_DB=leveldb
QFABRIC_CHANNEL=mychannel
QFABRIC_CHAINCODE=qfabric-audit
# Which organization the Go client acts as: OrgA (Org1MSP) or OrgB (Org2MSP)
QFABRIC_ORG=OrgA
QFABRIC_CRYPTO_API_URL=http://localhost:8000/api/v1
# Defaults to network/fabric-samples/test-network relative to blockchain/
# QFABRIC_TEST_NETWORK_DIR=
